COMPOSE_PROJECT=amazing-http-logger-dev
MONGO_IMAGE=mongo:7
MONGO_BIND_HOST=127.0.0.1
MONGO_HOST=localhost
MONGO_PORT=28017
MONGO_REPLICA_SET=rs0
MONGO_URI=mongodb://${MONGO_HOST}:${MONGO_PORT}/?replicaSet=${MONGO_REPLICA_SET}
MONGO_DB_NAME=amazing_http_logger
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# Single-node local development only; Helm keeps secondary-only analysis reads.
MONGO_ALLOW_PRIMARY_READS=true
WORKER_RETRY_SECONDS=1
# Local raw upload storage and both Pub/Sub hops. Production uses GCS/ADC.
SPOOL_STORAGE_BACKEND=minio
SPOOL_BUCKET=traffic-uploads
SPOOL_SUBSCRIPTION=projects/logger-local/subscriptions/uploads
SPOOL_EVENT_TOPIC=projects/logger-local/topics/uploads
SPOOL_SILVER_TOPIC=projects/logger-local/topics/uploads-silver
SPOOL_SILVER_SUBSCRIPTION=projects/logger-local/subscriptions/uploads-silver
SPOOL_PARSE_DLQ_TOPIC=projects/logger-local/topics/parse-dlq
SPOOL_LOAD_DLQ_TOPIC=projects/logger-local/topics/load-dlq
# Partition namespace only, NOT a new authentication tenant.
SPOOL_TENANT=deployment
SPOOL_LEASE_SECONDS=180
SPOOL_PROCESSING_SECONDS=60
SPOOL_MAX_ATTEMPTS=3
# Per loader replica; multiply by replica count to obtain deployment rate.
SPOOL_MONGO_DOCUMENTS_PER_SECOND=500
# Published dependency ports; container clients use Compose DNS/internal ports.
MINIO_PORT=29000
MINIO_CONSOLE_PORT=29001
PUBSUB_PORT=28681
SPOOL_ENDPOINT_URL=http://localhost:${MINIO_PORT}
PUBSUB_EMULATOR_HOST=localhost:${PUBSUB_PORT}
GOOGLE_CLOUD_PROJECT=logger-local
SPOOL_MINIO_ACCESS_KEY_FILE=.secrets/minio-access-key
SPOOL_MINIO_SECRET_KEY_FILE=.secrets/minio-secret-key
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_AUDIENCE=https://my-fastapi-api
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=9090
FRONTEND_PORT=3000
# Optional override; Compose reads frontend/.env followed by this file.
FRONTEND_ENV_FILE=frontend/.env.local
PROXY_BIND_HOST=127.0.0.1
PROXY_PORT=8080
# Set https only when a trusted HTTPS tunnel/gateway forwards exclusively to this proxy.
PROXY_EXTERNAL_SCHEME=http
APP_RELOAD=true
REQUIRE_HTTPS=false
OPENBAO_IMAGE=ghcr.io/openbao/openbao:2.7.1
OPENBAO_BIND_HOST=127.0.0.1
OPENBAO_HOST=localhost
OPENBAO_PORT=28200
OPENBAO_ADDR=http://${OPENBAO_HOST}:${OPENBAO_PORT}
OPENBAO_TOKEN_FILE=.secrets/openbao-token
OPENBAO_DEV_ROOT_TOKEN_FILE=.secrets/openbao-dev-root-token
OPENBAO_TRANSIT_MOUNT=transit
OPENBAO_TRANSIT_KEY=log-keyset
OPENBAO_STORAGE_KEY=log-storage
OPENBAO_KV_MOUNT=secret
OPENBAO_KV_PATH=log-encryption
OPENBAO_TIMEOUT_SECONDS=5
OPENBAO_CA_CERT=
ENCRYPTION_KEY_ALGORITHM=ECDH-ES+A256KW
ENCRYPTION_CONTENT_ALGORITHM=A256GCM
ENCRYPTION_CURVE=P-384
# Behind an HTTPS gateway, trust only its actual IPs/CIDRs, never arbitrary clients.
FORWARDED_ALLOW_IPS=127.0.0.1
