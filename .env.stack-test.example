# Copy to .env.stack-test (ignored). Use dedicated non-production OAuth applications.
STACK_TEST_ENABLED=false
# Public local NGINX origin; also the default when this setting is omitted.
STACK_TEST_BASE_URL=http://localhost:8080
STACK_TEST_TOKEN_URL=https://your-domain.auth0.com/oauth/token
# Exact backend AUTH0_AUDIENCE (Auth0 API Identifier).
STACK_TEST_AUDIENCE=
STACK_TEST_PLAINTEXT_CLIENT_ID=
STACK_TEST_PLAINTEXT_CLIENT_SECRET=
# Optional assertions; actual device IDs are discovered from authenticated GET /me.
STACK_TEST_PLAINTEXT_DEVICE_ID=
# Configure this device's policy before running: optional or required JWE.
# Neither test client needs manage:devices; the test never changes policies.
STACK_TEST_ENCRYPTED_CLIENT_ID=
STACK_TEST_ENCRYPTED_CLIENT_SECRET=
STACK_TEST_ENCRYPTED_DEVICE_ID=
STACK_TEST_HTTP_TIMEOUT=10
STACK_TEST_VISIBILITY_TIMEOUT=30
# Optional PEM CA bundle for a private backend CA; system roots remain trusted.
STACK_TEST_CA_CERT=
