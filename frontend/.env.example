# Copy to frontend/.env.local. Keep these settings server-side.
# Set the listener separately: make frontend-dev FRONTEND_PORT=3000
APP_BASE_URL=http://localhost:8080
# Server-side API address; the browser accesses the application through the proxy.
# Origin only: do not append /api or /api/v1; request paths already include /api/v1.
# Production defaults to the public HTTPS ingress origin for server-side API requests.
BACKEND_API_URL=http://127.0.0.1:9090
BACKEND_API_TIMEOUT_MS=10000

# Dedicated Auth0 Regular Web Application, NOT an agent's M2M credentials.
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 64 character random string to encrypt the session cookie
#
# We're generating a secret for your convenience, but for production,
# generate your own secret using `openssl rand -hex 32`
AUTH0_SECRET=
# Copy the exact AUTH0_AUDIENCE from the backend configuration (Auth0 API Identifier).
# That Auth0 API must issue RS256 access tokens; HS256 is not supported.
AUTH0_AUDIENCE=
# This is the management UI's scope, not a requirement for ordinary agents.
AUTH0_SCOPE=openid profile email manage:devices
